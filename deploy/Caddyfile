# Centreal reverse proxy — the ONLY service that publishes ports (80/443).
#
# Variables (from deploy/.env.prod, passed through docker-compose.prod.yml):
#   SITE_ADDRESS    ":80" → plain HTTP on the server IP (IP-only mode, default)
#                   "centreal.ru, www.centreal.ru" → Caddy obtains Let's Encrypt
#                   certificates automatically and redirects HTTP → HTTPS.
#   CANONICAL_HOST  "centreal.ru" — www.<it> answers 301 → https://<it>{uri}.
#   PUBLIC_IP       "217.114.1.193" — http://<it> answers 301 → https://<CANONICAL_HOST>{uri}.
# With CANONICAL_HOST / PUBLIC_IP unset the defaults below match no real
# request (www.localhost, 192.0.2.1 = TEST-NET-1), so IP-only mode is unchanged.
# Changing them needs only `docker compose ... up -d caddy` (plus a frontend
# rebuild for the new NEXT_PUBLIC_SITE_URL — see deploy/README.md).
# No HSTS yet: add it only once HTTPS has been stable for a while.

(site_routes) {
	encode zstd gzip

	# --- Django API -----------------------------------------------------------
	# Same contract as the Next.js rewrite in frontend/next.config.ts: Django
	# always receives a trailing slash. Without it APPEND_SLASH answers a
	# slash-less POST with a 301, and the browser re-sends it as a GET with no
	# body. Query strings are preserved.
	@api_no_slash path_regexp ^/api/.*[^/]$
	rewrite @api_no_slash {path}/?{query}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# --- Django admin + its static files (WhiteNoise in the backend) -----------
	handle /admin* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}

	# --- Media -----------------------------------------------------------------
	# MEDIA_STORAGE_BACKEND=r2 (production): Django emits ABSOLUTE bucket URLs
	# (MEDIA_URL = https://<AWS_S3_CUSTOM_DOMAIN>/), so nothing on the site points
	# at /media/ and these requests are only stale links → 404 is the honest
	# answer.
	# MEDIA_STORAGE_BACKEND=local: files live in the shared `media` volume
	# (written by backend + celery) and Caddy serves them read-only. Django
	# itself only serves /media/ when DEBUG=True, which production never is.
	#
	# Browser caching (2026-10-26): every upload key is `<folder>/<yyyy>/<mm>/<uuid4>.<ext>`
	# (common/upload_paths.UniqueUploadTo) and storage never overwrites, so a
	# stored file's bytes never change under the same URL: cache it for a year.
	# Without this header the browser had only ETag/Last-Modified and guessed a
	# freshness of ~10% of the file's age, then revalidated every photo.
	#  - `file {path}` makes the header apply only when the file EXISTS, so a 404
	#    is never cached for a year.
	#  - /media/imports/* (CRM import uploads) is excluded and sent no-store.
	handle /media/* {
		root * /srv
		@cacheable {
			not path /media/imports/*
			file {path}
		}
		header @cacheable Cache-Control "public, max-age=31536000, immutable"
		@private path /media/imports/*
		header @private Cache-Control "private, no-store"
		file_server
	}

	# --- Everything else → Next.js -----------------------------------------------
	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
	}
}

{$SITE_ADDRESS::80} {
	# www → the bare domain. redir runs before rewrite/handle, so {uri} is the
	# original request URI.
	@www host www.{$CANONICAL_HOST:localhost}
	redir @www https://{$CANONICAL_HOST:localhost}{uri} permanent

	import site_routes
}

# Requests by bare IP → the domain. Only port 80: no certificate exists for an IP.
http://{$PUBLIC_IP:192.0.2.1} {
	redir https://{$CANONICAL_HOST:localhost}{uri} permanent
}
