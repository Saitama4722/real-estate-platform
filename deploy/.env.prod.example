# =============================================================================
# Centreal — production environment for docker-compose.prod.yml
#
#   cp deploy/.env.prod.example deploy/.env.prod   (on the SERVER only)
#
# ⛔ deploy/.env.prod holds real secrets. It lives ONLY on the VPS and is
# gitignored. Never commit it, never copy it to a dev machine.
# Values below are for the IP-only phase (217.114.1.193). For the domain switch
# see deploy/README.md → «Переход на домен».
# =============================================================================

# --- Caddy -------------------------------------------------------------------
# ":80" = plain HTTP on the IP. Domain mode: centreal.ru, www.centreal.ru → Caddy
# gets Let's Encrypt certificates by itself (DNS A-records must point here).
SITE_ADDRESS=:80
# Domain mode only; leave empty for the IP-only phase.
# CANONICAL_HOST: the main domain, no scheme. www.<it> → 301 → https://<it>.
CANONICAL_HOST=
# PUBLIC_IP: the server's IP. http://<it> → 301 → https://<CANONICAL_HOST>.
PUBLIC_IP=

# --- Django (backend, celery, celery-beat) ------------------------------------
# ⚠ THE DJANGO_ PREFIX IS REQUIRED. A bare SECRET_KEY / DEBUG / ALLOWED_HOSTS is
# read by nothing. The deployed guard refuses to boot without DJANGO_SECRET_KEY.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# DJANGO_DEBUG is forced to False by docker-compose.prod.yml; not set here.

# Comma-separated host names, NO scheme. Must contain:
#   the public IP / domain   (what browsers send via Caddy)
#   backend                  (Next.js server-side fetches use http://backend:8000)
#   localhost                (the container healthcheck)
DJANGO_ALLOWED_HOSTS=217.114.1.193,backend,localhost

# WITH scheme. ⚠ A bare host gets "https://" prepended by settings.py, which
# breaks admin login over plain HTTP — so write http:// explicitly for the IP.
CSRF_TRUSTED_ORIGINS=http://217.114.1.193
# Browser calls go same-origin through Caddy, so this is a safety list only.
CORS_ALLOWED_ORIGINS=http://217.114.1.193

# Public site URL for absolute links in notifications. No trailing slash.
SITE_URL=http://217.114.1.193

# Optional; seconds Django keeps a DB connection open (default 600).
CONN_MAX_AGE=

# --- PostgreSQL (db service + Django's DATABASE_URL) ---------------------------
# DATABASE_URL is assembled from these in docker-compose.prod.yml
# (postgres://USER:PASSWORD@db:5432/DB). ⚠ The password goes into a URL: use
# letters and digits only (no @ : / ? # %), e.g. secrets.token_hex(24).
# CENTREAL_DATABASE_URL is a LOCAL-dev escape hatch — do NOT set it here.
POSTGRES_DB=real_estate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Redis / Celery ------------------------------------------------------------
# REDIS_URL, CELERY_BROKER_URL and CELERY_RESULT_BACKEND are fixed to
# redis://redis:6379/0 inside docker-compose.prod.yml — nothing to set.

# --- Media storage ---------------------------------------------------------------
# r2  = Cloudflare R2 (recommended; the restored DB's photo keys live there).
# local = files in the `media` Docker volume, served by Caddy at /media/.
# ⚠ There is ONE R2 bucket shared with history — read
# docs/claude/media-and-images.md before any bulk media operation.
MEDIA_STORAGE_BACKEND=r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=centreal-media
# https://<account_id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Public bucket host WITHOUT https:// (e.g. pub-xxxx.r2.dev). Required for r2.
AWS_S3_CUSTOM_DOMAIN=

# --- Lead notifications (Telegram) ---------------------------------------------
LEADS_NOTIFICATIONS_ENABLED=True
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Initial superadmin ------------------------------------------------------------
# Used ONLY when the database has no superuser (create_initial_admin runs on
# every backend start). Set both for the very first start of an EMPTY database,
# then delete the password line and `up -d backend`. Not needed when the DB is
# restored from the desktop dump (it already has superusers). No default exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Frontend (Next.js) — BUILD ARGS -------------------------------------------------
# ⚠ Inlined into the JS bundle at BUILD time. Changing them requires
#   docker compose -f docker-compose.prod.yml --env-file deploy/.env.prod up -d --build frontend
# These are the only NEXT_PUBLIC_* variables the code reads.
NEXT_PUBLIC_SITE_URL=http://217.114.1.193
NEXT_PUBLIC_API_URL=http://217.114.1.193/api
# BACKEND_URL is fixed to http://backend:8000 in docker-compose.prod.yml.

# --- Frontend — RUNTIME (server-side only, not baked into the bundle) ------------
# Contact address in the User-Agent of Nominatim (OpenStreetMap) address-search
# requests; their usage policy asks for one. Empty = sent without it.
NOMINATIM_CONTACT_EMAIL=
