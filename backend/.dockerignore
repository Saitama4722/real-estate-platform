# Build context for backend/Dockerfile (`COPY . .` copies everything NOT listed here).
#
# The image needs only: requirements.txt, manage.py, config/, the app packages
# (incl. their management/commands and migrations) and static/ (STATICFILES_DIRS;
# collectstatic runs INSIDE the build). No fixture is loaded at startup — the
# CMD is migrate + create_initial_admin + gunicorn.
#
# ⛔ Anything secret or local-only must be listed here BEFORE any image build.
# Patterns are relative to backend/; `**/` is needed to match below the root.

# --- Virtualenvs (the dev venv lives in %LOCALAPPDATA%; old ones may linger) ---
.venv/
venv/
env/

# --- Python / tooling caches ---
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Secrets ---
.env
.env.*
!.env.example

# --- Local data: media, collected static, databases, dumps, backups ---
# staticfiles/ is regenerated by collectstatic during the build.
media/
staticfiles/
**/*.sqlite3
**/*.dump
**/*.sql
backup*.json
backup_local.json
# Personal data (users / owner); not in the repo, but never let a local copy ship.
fixtures/transfer/03_users.json
fixtures/transfer/04_owner.json

# --- VCS / editors / logs ---
.git/
.gitignore
.idea/
.vscode/
**/*.log
logs/

# --- Build/deploy config not needed inside the image ---
Dockerfile.dev
docker-compose*.yml
nixpacks.toml
