# backend/.env.example — variables specific to backend start-up.
# The full list of backend variables (DJANGO_*, CENTREAL_DATABASE_URL, media,
# Redis, ...) is documented in the repository-root .env.example.

# Initial superadmin, read by `manage.py create_initial_admin` (run on every
# container start). Used ONLY when the database has no superuser yet; ignored
# otherwise. Set both for the very first start of a new server (or restore the
# database from a dump instead), then REMOVE the password from the environment.
# If either is empty, no admin is created; there is no default.
# The password must pass Django's password validators.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
