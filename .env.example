# =============================================================================
# Django Backend
# =============================================================================
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Include "backend" when using Docker Compose (service DNS name for in-network HTTP).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# =============================================================================
# PostgreSQL
# =============================================================================
# When using Docker Compose, the backend service overrides POSTGRES_HOST to "db".
POSTGRES_DB=real_estate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# Next.js Frontend
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser → published Django port (Compose maps backend 8000 → host 8001).
NEXT_PUBLIC_API_URL=http://localhost:8001/api
# Next.js server (SSR/build/sitemap) when running `npm run dev` on the host: Django URL as seen from that process.
# Do not rely on this for the Docker Compose `frontend` service — compose sets BACKEND_URL=http://backend:8000 there.
BACKEND_URL=http://localhost:8001

# =============================================================================
# Task queue (Celery + Redis, Stage 14.5)
# =============================================================================
# Local broker (host machine or published Docker port 6379).
REDIS_URL=redis://127.0.0.1:6379/0
# Optional overrides (default: same as REDIS_URL).
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# When unset: False (tasks go to the broker; run Redis + worker, or set eager).
# Set to true for in-process execution without a worker (tests / quick local runs).
# CELERY_TASK_ALWAYS_EAGER=

# =============================================================================
# Media / Storage
# =============================================================================
# Django reads MEDIA_STORAGE_BACKEND (see config/settings.py). MEDIA_STORAGE is accepted as legacy fallback.
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# =============================================================================
# Maps
# =============================================================================
NEXT_PUBLIC_MAP_PROVIDER=yandex
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# =============================================================================
# Auth / Security
# =============================================================================
ACCESS_PHONE_REVEAL_LOGGING=True
LEADS_NOTIFICATIONS_ENABLED=True

# =============================================================================
# Optional: CORS, Sentry, Email
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
SENTRY_DSN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
