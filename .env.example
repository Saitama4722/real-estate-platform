# =============================================================================
# Django Backend
# =============================================================================
DJANGO_SECRET_KEY=
# Local: True. Production (Railway): False
DJANGO_DEBUG=True
# Comma-separated hostnames. In production set explicitly (e.g. Railway hostname).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,real-estate-platform

# =============================================================================
# PostgreSQL
# =============================================================================
# Railway/production: set DATABASE_URL (recommended)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
# Used only when DATABASE_URL is empty (typical local / Compose)
POSTGRES_DB=real_estate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# Next.js Frontend
# =============================================================================
# Local development (default below).
#
# Railway / split services — avoid ERR_TOO_MANY_REDIRECTS on /api/*:
# Next.js proxies /api in frontend/next.config.ts rewrites using BACKEND_URL at build/start.
# BACKEND_URL must NOT resolve to the same origin as NEXT_PUBLIC_SITE_URL, or the proxy calls itself in a loop.
# If SITE and NEXT_PUBLIC_API_URL are the same origin, set BACKEND_INTERNAL_URL to Django’s private URL.
#
# Choose one pattern:
# (A) BACKEND_URL = Django service URL only (recommended): Railway private HTTP URL to the backend service
#     (e.g. http://backend.railway.internal:8000) OR the backend’s own public hostname — never the frontend URL.
#     NEXT_PUBLIC_API_URL can match the frontend’s public URL /api if you want same-origin browser calls.
# (B) NEXT_PUBLIC_API_URL = Django’s public API base on a different host (https://your-backend.up.railway.app/api).
#     Set CORS_ALLOWED_ORIGINS on Django to include the frontend origin.
#
# NEXT_PUBLIC_SITE_URL=https://your-frontend.up.railway.app
# NEXT_PUBLIC_API_URL=https://your-frontend.up.railway.app/api
# BACKEND_URL=http://your-backend-service.railway.internal:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public API base including /api — used for server-side / public catalog fetches (see frontend publicProperty).
# Employee/CRM requests in the browser use same-origin /api/... and are proxied by Next to BACKEND_URL.
NEXT_PUBLIC_API_URL=http://localhost:8001/api
# Django origin for the Next.js /api proxy (no /api suffix). Required in production.
# Docker Compose: prefer http://backend:8000 from the frontend container. The backend
# service also has network alias real-estate-platform so http://real-estate-platform:8000 works.
BACKEND_URL=http://localhost:8001
# Same-host only: Django private origin when BACKEND_URL cannot differ from the site (see comment block above).
# BACKEND_INTERNAL_URL=

# =============================================================================
# Task queue (Celery + Redis)
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
# Optional overrides (default: same as REDIS_URL)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# CELERY_TASK_ALWAYS_EAGER=

# =============================================================================
# Media / Storage
# =============================================================================
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# =============================================================================
# Maps
# =============================================================================
NEXT_PUBLIC_MAP_PROVIDER=yandex
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# =============================================================================
# Auth / Security
# =============================================================================
CSRF_TRUSTED_ORIGINS=
ACCESS_PHONE_REVEAL_LOGGING=True
LEADS_NOTIFICATIONS_ENABLED=True

# =============================================================================
# CORS (production)
# =============================================================================
# When DJANGO_DEBUG=False, set comma-separated HTTPS origins (your public Railway URL).
# Example: https://loyal-miracle-production-cb88.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Production (Railway) — backend reference values
# =============================================================================
# Backend: set PORT=8000 on the Django service so Railway health checks / edge routing match
# Gunicorn (listens on 0.0.0.0:8000). Omitting this leaves Railway’s default PORT ≠ 8000 and
# breaks callers that use private HTTP on port 8000 (ECONNREFUSED).
# PORT=8000
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=loyal-miracle-production-cb88.up.railway.app
# CORS_ALLOWED_ORIGINS=https://loyal-miracle-production-cb88.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://loyal-miracle-production-cb88.up.railway.app

# =============================================================================
# Optional
# =============================================================================
SENTRY_DSN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
