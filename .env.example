# =============================================================================
# Django Backend
# =============================================================================
DJANGO_SECRET_KEY=
# Local: True. Production (Railway): False
DJANGO_DEBUG=True
# Comma-separated hostnames. In production set explicitly (e.g. Railway hostname).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,real-estate-platform

# =============================================================================
# PostgreSQL
# =============================================================================
# ── Database resolution order: CENTREAL_DATABASE_URL → DATABASE_URL → POSTGRES_*
#
# ⚠ PREFER CENTREAL_DATABASE_URL FOR LOCAL DEVELOPMENT. It is checked FIRST and
# is project-specific, so it cannot collide with anything else on the machine.
# This matters concretely: a persistent User-level Windows `DATABASE_URL` set by
# an unrelated tool silently won over backend/.env, and Django connected to that
# tool's database instead — the site looked empty while the real rows sat
# untouched, and `manage.py test` built `test_<that other db>`. load_dotenv()
# NEVER overrides a variable already present in the environment.
#
# The backend prints the database it resolved on every start, and prints a loud
# banner when the name is not the expected local one. Read that line.
CENTREAL_DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/real_estate_db
# Name the local database is expected to have; drives that startup check.
# CENTREAL_EXPECTED_DB_NAME=real_estate_db

# Railway/production: set DATABASE_URL (recommended). Used when
# CENTREAL_DATABASE_URL is absent, so production needs no change.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
# Used only when BOTH URL variables above are empty (typical Compose)
POSTGRES_DB=real_estate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# Next.js Frontend
# =============================================================================
# Local development (default below).
#
# Railway / split services — avoid ERR_TOO_MANY_REDIRECTS on /api/*:
# Next.js proxies /api in frontend/next.config.ts rewrites using BACKEND_URL at build/start.
# BACKEND_URL must NOT resolve to the same origin as NEXT_PUBLIC_SITE_URL, or the proxy calls itself in a loop.
# If SITE and NEXT_PUBLIC_API_URL are the same origin, set BACKEND_INTERNAL_URL to Django’s private URL.
#
# Choose one pattern:
# (A) BACKEND_URL = Django service URL only (recommended): Railway private HTTP URL to the backend service
#     (e.g. http://backend.railway.internal:8000) OR the backend’s own public hostname — never the frontend URL.
#     NEXT_PUBLIC_API_URL can match the frontend’s public URL /api if you want same-origin browser calls.
# (B) NEXT_PUBLIC_API_URL = Django’s public API base on a different host (https://your-backend.up.railway.app/api).
#     Set CORS_ALLOWED_ORIGINS on Django to include the frontend origin.
#
# NEXT_PUBLIC_SITE_URL=https://your-frontend.up.railway.app
# NEXT_PUBLIC_API_URL=https://your-frontend.up.railway.app/api
# BACKEND_URL=http://your-backend-service.railway.internal:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Public API base including /api — used for server-side / public catalog fetches (see frontend publicProperty).
# Employee/CRM requests in the browser use same-origin /api/... and are proxied by Next to BACKEND_URL.
NEXT_PUBLIC_API_URL=http://localhost:8001/api
# Django origin for the Next.js /api proxy (no /api suffix). Required in production.
# Docker Compose: prefer http://backend:8000 from the frontend container. The backend
# service also has network alias real-estate-platform so http://real-estate-platform:8000 works.
BACKEND_URL=http://localhost:8001
# Same-host only: Django private origin when BACKEND_URL cannot differ from the site (see comment block above).
# BACKEND_INTERNAL_URL=

# =============================================================================
# Task queue (Celery + Redis)
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
# Optional overrides (default: same as REDIS_URL)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# CELERY_TASK_ALWAYS_EAGER=

# =============================================================================
# Media / Storage
# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT USES `local` — the default below. Files go to MEDIA_ROOT on
# disk and are served at /media/. Nothing contacts Cloudflare.
#
# ⚠ `r2` IS FOR PRODUCTION HOSTING ONLY. Do not set it on a dev machine. There
# is ONE bucket (centreal-media) and ONE set of credentials, so with r2 active
# every local upload — throwaway test uploads included — is written into the
# LIVE bucket. Worse, deleting the database row afterwards does NOT delete the
# stored object: nothing in this project removes files on delete, so the junk
# stays until someone removes it by hand. This has already happened once.
#
# The backend prints the active storage backend at startup and shows a loud
# banner if a cloud backend is active while DEBUG=True. Read that line.
#
# Valid values: local | r2 | s3
# =============================================================================
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# Cloudflare R2 / S3 — used ONLY when MEDIA_STORAGE_BACKEND is r2 or s3.
# Safe to leave populated while the backend is `local`: nothing reads them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=centreal-media
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxx.r2.dev   # public host, NO https:// prefix

# =============================================================================
# Maps
# =============================================================================
NEXT_PUBLIC_MAP_PROVIDER=yandex
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# =============================================================================
# Auth / Security
# =============================================================================
CSRF_TRUSTED_ORIGINS=
ACCESS_PHONE_REVEAL_LOGGING=True
# Master switch for outbound lead notifications (Telegram). Set False to disable.
LEADS_NOTIFICATIONS_ENABLED=True

# =============================================================================
# Lead notifications — Telegram
# =============================================================================
# Public-site absolute base URL (no trailing slash). Used to build the property
# link ("Страница") in the Telegram lead notification.
SITE_URL=https://centreal.ru
# Telegram bot credentials for new-lead notifications. Leave BOTH empty to
# disable sending (nothing is sent, lead creation is unaffected). Fill the real
# values in backend/.env only — never commit them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# CORS (production)
# =============================================================================
# When DJANGO_DEBUG=False, set comma-separated HTTPS origins (your public Railway URL).
# Example: https://loyal-miracle-production-cb88.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3001

# =============================================================================
# Production (Railway) — backend reference values
# =============================================================================
# Backend: set PORT=8000 on the Django service so Railway health checks / edge routing match
# Gunicorn (listens on 0.0.0.0:8000). Omitting this leaves Railway’s default PORT ≠ 8000 and
# breaks callers that use private HTTP on port 8000 (ECONNREFUSED).
# PORT=8000
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=loyal-miracle-production-cb88.up.railway.app
# CORS_ALLOWED_ORIGINS=https://loyal-miracle-production-cb88.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://loyal-miracle-production-cb88.up.railway.app

# =============================================================================
# Optional
# =============================================================================
SENTRY_DSN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
