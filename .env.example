# =============================================================================
# Django Backend
# =============================================================================
DJANGO_SECRET_KEY=
# Local: True. Production (Railway): False
DJANGO_DEBUG=True
# Comma-separated hostnames. Production: your Railway hostname and custom domain.
# If unset in production, RAILWAY_PUBLIC_DOMAIN is used when provided by Railway.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# =============================================================================
# PostgreSQL
# =============================================================================
# Railway/production: set DATABASE_URL (recommended)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
# Used only when DATABASE_URL is empty (typical local / Compose)
POSTGRES_DB=real_estate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# Next.js Frontend
# =============================================================================
# Canonical site URL (SEO, sitemap). On Vercel you can rely on VERCEL_URL if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public API base including /api — used in the browser and for SSR when BACKEND_URL is unset
NEXT_PUBLIC_API_URL=http://localhost:8001/api
# Next.js rewrites and server-side fetch: Django origin without path (same host as NEXT_PUBLIC_API_URL in many setups).
# Docker Compose frontend service sets this to http://backend:8000
BACKEND_URL=http://localhost:8001

# =============================================================================
# Task queue (Celery + Redis)
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
# Optional overrides (default: same as REDIS_URL)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# CELERY_TASK_ALWAYS_EAGER=

# =============================================================================
# Media / Storage
# =============================================================================
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# =============================================================================
# Maps
# =============================================================================
NEXT_PUBLIC_MAP_PROVIDER=yandex
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# =============================================================================
# Auth / Security
# =============================================================================
CSRF_TRUSTED_ORIGINS=
ACCESS_PHONE_REVEAL_LOGGING=True
LEADS_NOTIFICATIONS_ENABLED=True

# =============================================================================
# CORS (production)
# =============================================================================
# When DJANGO_DEBUG=False, set comma-separated origins (e.g. your Vercel URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Optional
# =============================================================================
SENTRY_DSN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
